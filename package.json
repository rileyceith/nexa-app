{
  "name": "nexa-frontend",
  "private": true,
  "scripts": {
    "build:frontend": "esbuild frontend/src/main.jsx --bundle --minify --outfile=frontend/Nexa.js --format=iife --platform=browser --target=es2020 --jsx=automatic",
    "build:mobile": "npm run build:frontend && node scripts/build-mobile.cjs",
    "sync:mobile": "npm run build:mobile && cap sync",
    "test:mobile": "node --test scripts/mobile.test.cjs",
    "test": "npm run test:mobile"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "^0.28.2"
  }
}
